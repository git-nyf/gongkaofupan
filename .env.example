DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PORT=8787
# 仅本机访问使用 127.0.0.1；同一局域网访问使用 0.0.0.0
HOST=127.0.0.1
DATA_DIR=./data
ANKI_OUTPUT_DIR=./output/anki
CC_CONNECT_COMMAND=cc-connect
# cc-connect 使用的消息数据目录；留空时使用默认目录
CC_CONNECT_DATA_DIR=
# 花生十三 MCP 的 SSE 地址
HUASHENG_MCP_URL=http://127.0.0.1:8000/sse
# 张弓 Skill 所在目录；留空时不启用
ZHANG_GONG_SKILL_DIR=
# Tavily 联网搜索 API Key；留空时不启用
TAVILY_API_KEY=
